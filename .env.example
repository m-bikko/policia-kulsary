# ── Supabase (интеграция Vercel ↔ Supabase заполняет их автоматически) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Публичный ключ - только чтение контента (подойдёт любой из двух)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Серверный ключ - запись контента и загрузка фото. НИКОГДА не делайте его NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Прямое подключение к Postgres - нужно только для pnpm db:migrate
POSTGRES_URL_NON_POOLING=

# ── Редактор /edit ──
# PIN-код входа в редактор
ADMIN_PIN=123123
# Необязательно: секрет подписи cookie сессии (по умолчанию - производная от PIN и service-ключа)
ADMIN_SESSION_SECRET=

# ── Keep-alive (чтобы бесплатный Supabase не уходил на паузу) ──
# Необязательно, но рекомендуется на Vercel: Vercel Cron сам пришлёт его в заголовке Authorization
CRON_SECRET=
